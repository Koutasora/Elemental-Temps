{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "SDKVersion": 3,
  "UUID": "com.elemental.temps",
  "Name": "Elemental Temps",
  "Version": "1.1.1.0",
  "Author": "Rafał",
  "Description": "CPU, GPU, disk temperatures, RAM usage and any HWiNFO sensor (water, fans, voltages…) on Stream Deck keys, with a gauge, bar, history graph or big number.",
  "Icon": "imgs/plugin-icon",
  "Category": "Elemental Temps",
  "CategoryIcon": "imgs/category-icon",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Actions": [
    {
      "UUID": "com.elemental.temps.cpu",
      "Name": "CPU Temperature",
      "Tooltip": "Shows CPU temperature, load, power and clock speed.",
      "Icon": "imgs/action-cpu",
      "PropertyInspectorPath": "ui/cpu.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-cpu",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.elemental.temps.gpu",
      "Name": "GPU Temperature",
      "Tooltip": "Shows graphics card temperature, load, power and clock speed.",
      "Icon": "imgs/action-gpu",
      "PropertyInspectorPath": "ui/gpu.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-gpu",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.elemental.temps.disk",
      "Name": "Disk Temperature",
      "Tooltip": "Shows the temperature of a chosen disk.",
      "Icon": "imgs/action-disk",
      "PropertyInspectorPath": "ui/disk.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-disk",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.elemental.temps.ram",
      "Name": "RAM Usage",
      "Tooltip": "Shows how much memory is in use.",
      "Icon": "imgs/action-ram",
      "PropertyInspectorPath": "ui/ram.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-ram",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.elemental.temps.sensor",
      "Name": "Custom Sensor",
      "Tooltip": "Shows any HWiNFO temperature sensor, e.g. water or coolant temperature.",
      "Icon": "imgs/action-icon",
      "PropertyInspectorPath": "ui/sensor.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-default",
          "ShowTitle": false
        }
      ]
    }
  ]
}