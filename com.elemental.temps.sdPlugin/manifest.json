{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "SDKVersion": 3,
  "UUID": "com.elemental.temps",
  "Name": "Elemental Temps",
  "Version": "0.1.0.0",
  "Author": "Rafał",
  "Description": "CPU and GPU temperature on Stream Deck keys, with a gauge, bar, history graph or big number.",
  "Icon": "imgs/plugin-icon",
  "Category": "Elemental Temps",
  "CategoryIcon": "imgs/category-icon",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Actions": [
    {
      "UUID": "com.elemental.temps.temperature",
      "Name": "Temperature",
      "Tooltip": "Shows CPU or GPU temperature.",
      "Icon": "imgs/action-icon",
      "PropertyInspectorPath": "ui/temperature.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-default",
          "ShowTitle": false
        }
      ]
    }
  ]
}